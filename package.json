{
  "name": "sift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "dev:worker": "wrangler dev --local-protocol=https",
    "dev:worker:preview": "node scripts/dev-worker-preview.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "start": "node server/index.js",
    "db:local:migrate": "wrangler d1 migrations apply sift --local",
    "test": "node --test",
    "test:worker": "node --test tests/cloudflare.test.js",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "jose": "^6.2.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.156.0"
  }
}
